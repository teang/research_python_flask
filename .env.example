# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True

# Database Configuration
# Choose one of the following database configurations:

# SQLite (Default - for development)
# DATABASE_URL=sqlite:///research.db

# PostgreSQL (Recommended for production)
DATABASE_URL=postgresql://username:password@localhost:5432/research_db

# PostgreSQL with specific settings
# DATABASE_URL=postgresql://research_user:your_password@localhost:5432/research_db

# MySQL/MariaDB (Alternative)
# DATABASE_URL=mysql://username:password@localhost:3306/research_db

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Email Configuration (Optional - for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@research.local

# Upload Configuration (Optional - defaults are in config.py)
# MAX_CONTENT_LENGTH=52428800  # 50 MB in bytes
# UPLOAD_FOLDER=/path/to/uploads

# Session Configuration (Optional)
# PERMANENT_SESSION_LIFETIME=7  # days
