# Production Environment Variables
# Copy this file to .env and fill in the actual values

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://research_user:your_password@postgres:5432/research_db
DB_USER=research_user
DB_PASSWORD=your_password
DB_NAME=research_db
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://:redis_pass@redis:6379/0
REDIS_PASSWORD=redis_pass
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://:redis_pass@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_pass@redis:6379/2

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_TIME_LIMIT=None

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://:redis_pass@redis:6379/3

# Sentry (Error Monitoring)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# File Upload
MAX_CONTENT_LENGTH=52428800  # 50MB in bytes
UPLOAD_FOLDER=/app/app/static/uploads

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
WEB_PORT=5000

# JWT (if implementing API tokens)
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600

# Application Settings
ITEMS_PER_PAGE=10
SESSION_PERMANENT_LIFETIME=604800  # 7 days in seconds

# SSL (if using)
# SSL_CERT_FILE=/path/to/cert.pem
# SSL_KEY_FILE=/path/to/key.pem

# Backup Configuration
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# Monitoring
PROMETHEUS_METRICS_ENABLED=True
